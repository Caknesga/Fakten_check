{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "name": "BAware",
  "version": "2.2.0",
  "description": "A traffic light summary of prepared fact checks for selected demo pages.",
  "homepage_url": "https://faktencheck-ampel-reports.roundgiant4096.chatgpt.site",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BAware",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.spiegel.de/*",
    "https://*.facebook.com/*",
    "https://*.sciencedirect.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
